{
  "name": "rydspine-mcp",
  "version": "0.0.0",
  "private": true,
  "description": "MCP server that rigs and animates Spine 4.3 skeletons from natural-language requests",
  "license": "MIT",
  "author": "Ryder Dinh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ryderdinh/rydspine-mcp.git"
  },
  "homepage": "https://github.com/ryderdinh/rydspine-mcp#readme",
  "bugs": {
    "url": "https://github.com/ryderdinh/rydspine-mcp/issues"
  },
  "keywords": [
    "mcp",
    "spine",
    "spine2d",
    "esoteric",
    "animation",
    "rigging",
    "model-context-protocol"
  ],
  "type": "module",
  "scripts": {
    "start": "tsx src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc",
    "spike:check": "tsx spike/runtime-check.ts",
    "acceptance": "tsx acceptance/build.ts",
    "spine:check": "tsx acceptance/spine-check.ts",
    "ui": "tsx src/ui.ts",
    "skel:examples": "tsx acceptance/skel-examples.ts",
    "real:art": "tsx acceptance/real-art.ts",
    "setup": "tsx src/setup.ts",
    "installers": "tsx installer/build.ts"
  },
  "dependencies": {
    "@esotericsoftware/spine-core": "4.3.13",
    "@esotericsoftware/spine-player": "4.3.13",
    "@kninnug/constrainautor": "4.1.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "ag-psd": "34.1.0",
    "delaunator": "5.1.0",
    "playwright": "1.64.1",
    "pngjs": "7.0.0",
    "tsx": "4.23.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/delaunator": "5.0.3",
    "@types/node": "26.6.6",
    "@types/pngjs": "6.0.5",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "bin": {
    "rydspine-mcp": "src/index.ts"
  },
  "engines": {
    "node": ">=20"
  }
}
